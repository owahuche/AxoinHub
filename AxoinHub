local function keyGate()
    local cached = readCache()
    if cached and validateKey(cached, MY_HWID) then
        return true
    elseif cached then
        clearCache()
    end

    local sg, state = buildKeyGui(MY_HWID)
    while not state.verified and not state.closed and sg.Parent do
        task.wait(0.2)
    end
    return state.verified
end

