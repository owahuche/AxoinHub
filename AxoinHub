local function buildArsenal(page, ctx)
    local Hub = ctx.Hub

    local AR = {
        aimbot = false, aimKey = Enum.UserInputType.MouseButton2,
        aimSmooth = 0.35, aimFOV = 120, aimPart = "Head",
        aimVisible = true, aimTeamCheck = true, aimTarget = nil,
        silentAim = false,
        triggerBot = false, triggerDelay = 0.05,
        espOn = true, espBoxes = true, espNames = true, espDistance = true,
        espTracers = false, espHealth = true, espTeamCheck = false, espRange = 800,
        espCache = {},
        radarOn = false, radarRadius = 150,
        noRecoil = false, noSpread = false, noSway = false,
        infiniteAmmo = false, fastReload = false,
        noFog = false, fullbright = false,
        autoFire = false, autoFireDelay = 0.1,
        hitSounds = false, antiAFK = true,
        sessionStart = tick(), shotsFired = 0,
        lastAction = "idle", debugLines = {},
    }

    local function arlog(m)
        local t = os.date("%H:%M:%S")
        table.insert(AR.debugLines, string.format("[%s] %s", t, m))
        while #AR.debugLines > 12 do table.remove(AR.debugLines, 1) end
    end

    local function sameTeam(plr)
        if not AR.aimTeamCheck then return false end
        if not plr then return false end
        if plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then return true end
        if plr.TeamColor and LocalPlayer.TeamColor and plr.TeamColor == LocalPlayer.TeamColor then return true end
        return false
    end

    local function isVisible(part)
        if not AR.aimVisible then return true end
        local cam = Workspace.CurrentCamera
        if not cam then return false end
        local origin = cam.CFrame.Position
        local dir = part.Position - origin
        local ray = Ray.new(origin, dir)
        local ignore = { LocalPlayer.Character, cam }
        local hit = Workspace:FindPartOnRayWithIgnoreList(ray, ignore)
        if not hit then return true end
        return hit:IsDescendantOf(part.Parent) or hit == part
    end

    local function getAimPart(plr, partName)
        local char = plr.Character
        if not char then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return nil end
        return char:FindFirstChild(partName) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    end

    local function findTarget()
        local cam = Workspace.CurrentCamera
        if not cam then return nil end
        local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        local best, bestDist = nil, AR.aimFOV
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and not sameTeam(plr) then
                local part = getAimPart(plr, AR.aimPart)
                if part then
                    local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if dist < bestDist then
                            if isVisible(part) then
                                best = { player = plr, part = part, dist = dist }
                                bestDist = dist
                            end
                        end
                    end
                end
            end
        end
        return best
    end

    local function aimTick()
        if not AR.aimbot then AR.aimTarget = nil; return end
        if not UserInputService:IsMouseButtonPressed(AR.aimKey) then AR.aimTarget = nil; return end
        local cam = Workspace.CurrentCamera
        if not cam then return end
        local target = findTarget()
        if not target then return end
        AR.aimTarget = target
        local desired = CFrame.new(cam.CFrame.Position, target.part.Position)
        local alpha = 1 - math.clamp(AR.aimSmooth, 0, 0.99)
        cam.CFrame = cam.CFrame:Lerp(desired, alpha)
    end

    local lastTrigger = 0
    local function triggerBotTick()
        if not AR.triggerBot then return end
        local now = tick()
        if now - lastTrigger < AR.triggerDelay then return end
        local cam = Workspace.CurrentCamera
        if not cam then return end
        local target = findTarget()
        if not target then return end
        lastTrigger = now
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(cam.ViewportSize.X/2, cam.ViewportSize.Y/2, 0, true, game, 1)
            task.wait(0.02)
            VirtualInputManager:SendMouseButtonEvent(cam.ViewportSize.X/2, cam.ViewportSize.Y/2, 0, false, game, 1)
        end)
        AR.shotsFired = AR.shotsFired + 1
    end

    local lastFire = 0
    local function autoFireTick()
        if not AR.autoFire then return end
        if not AR.aimTarget then return end
        local now = tick()
        if now - lastFire < AR.autoFireDelay then return end
        lastFire = now
        pcall(function()
            local cam = Workspace.CurrentCamera
            if not cam then return end
            VirtualInputManager:SendMouseButtonEvent(cam.ViewportSize.X/2, cam.ViewportSize.Y/2, 0, true, game, 1)
            task.wait(0.02)
            VirtualInputManager:SendMouseButtonEvent(cam.ViewportSize.X/2, cam.ViewportSize.Y/2, 0, false, game, 1)
        end)
        AR.shotsFired = AR.shotsFired + 1
    end

    local HAS_DRAWING = (Drawing ~= nil)
    local function new_drawing(class, props)
        if not HAS_DRAWING then return nil end
        local d = Drawing.new(class)
        for k, v in pairs(props) do d[k] = v end
        return d
    end
    local function espEntry(plr)
        if AR.espCache[plr] then return AR.espCache[plr] end
        if not HAS_DRAWING then return nil end
        local e = {
            box  = new_drawing("Square", { Thickness = 1, Filled = false, Transparency = 0.85, Color = CONFIG.TeamRed }),
            name = new_drawing("Text", { Text = "", Size = 13, Center = true, Outline = true, Color = Color3.new(1,1,1), Font = 2 }),
            dist = new_drawing("Text", { Text = "", Size = 11, Center = true, Outline = true, Color = Color3.new(1,1,1), Font = 2 }),
            hp   = new_drawing("Text", { Text = "", Size = 11, Center = true, Outline = true, Color = CONFIG.Safe, Font = 2 }),
        }
        if AR.espTracers then
            e.tracer = new_drawing("Line", { Thickness = 1, Transparency = 0.5, Color = CONFIG.TeamRed })
        end
        AR.espCache[plr] = e
        return e
    end
    local function removeEntry(e)
        if not e then return end
        for _, o in pairs(e) do pcall(function() o:Remove() end) end
    end
    local function clearEsp()
        for _, e in pairs(AR.espCache) do removeEntry(e) end
        AR.espCache = {}
    end
    local function drawEsp(plr)
        if not AR.espOn then return end
        if plr == LocalPlayer then return end
        if AR.espTeamCheck and sameTeam(plr) then
            if AR.espCache[plr] then removeEntry(AR.espCache[plr]); AR.espCache[plr] = nil end
            return
        end
        local char = plr.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end
        local myHrp = MOD.getHRP()
        if not myHrp then return end
        local dist = (hrp.Position - myHrp.Position).Magnitude
        if dist > AR.espRange then return end
        local cam = Workspace.CurrentCamera
        if not cam then return end
        local sp, onScreen = cam:WorldToViewportPoint(hrp.Position)
        if not onScreen then return end
        local e = espEntry(plr)
        if not e then return end
        local scale = 1 / math.max(dist, 1) * 500
        local w = math.max(8, 3 * scale * 0.5)
        local h = math.max(12, 5 * scale * 0.5)
        local color = sameTeam(plr) and CONFIG.TeamBlue or CONFIG.TeamRed
        e.box.Visible = AR.espBoxes
        e.box.Color = color
        e.box.Size = Vector2.new(w, h)
        e.box.Position = Vector2.new(sp.X - w/2, sp.Y - h/2)
        e.name.Visible = AR.espNames
        e.name.Position = Vector2.new(sp.X, sp.Y - h/2 - 16)
        e.name.Text = plr.Name
        e.dist.Visible = AR.espDistance
        e.dist.Position = Vector2.new(sp.X, sp.Y + h/2 + 2)
        e.dist.Text = string.format("%dm", math.floor(dist))
        e.hp.Visible = AR.espHealth
        e.hp.Position = Vector2.new(sp.X, sp.Y + h/2 + 16)
        e.hp.Text = string.format("%d HP", math.floor(hum.Health))
        if e.tracer then
            e.tracer.Visible = AR.espTracers
            e.tracer.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
            e.tracer.To = Vector2.new(sp.X, sp.Y + h/2)
            e.tracer.Color = color
        end
    end

    local radarGui, radarFrame = nil, nil
    local radarDots = {}
    local function buildRadar()
        if radarGui then return end
        radarGui = Instance.new("ScreenGui")
        radarGui.Name = "AXION_RADAR_" .. tostring(math.random(1e6))
        radarGui.ResetOnSpawn = false
        radarGui.IgnoreGuiInset = true
        radarGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        radarGui.Parent = getGuiParent()
        radarFrame = Instance.new("Frame")
        radarFrame.Size = UDim2.fromOffset(AR.radarRadius * 2, AR.radarRadius * 2)
        radarFrame.Position = UDim2.new(0, 20, 1, -(AR.radarRadius * 2) - 20)
        radarFrame.BackgroundColor3 = CONFIG.BG
        radarFrame.BackgroundTransparency = 0.25
        radarFrame.BorderSizePixel = 0
        radarFrame.Parent = radarGui
        corner(radarFrame, AR.radarRadius)
        stroke(radarFrame, CONFIG.Accent, 1, 0.3)
    end
    local function destroyRadar()
        if radarGui then radarGui:Destroy(); radarGui = nil; radarFrame = nil; radarDots = {} end
    end
    local function radarTick()
        if not AR.radarOn then return end
        if not radarGui then buildRadar() end
        if not radarFrame then return end
        local myHrp = MOD.getHRP()
        if not myHrp then return end
        local cam = Workspace.CurrentCamera
        if not cam then return end
        local camYaw = math.atan2(cam.CFrame.LookVector.X, cam.CFrame.LookVector.Z)
        for plr, dot in pairs(radarDots) do
            if not plr.Parent or not plr.Character then
                dot:Destroy(); radarDots[plr] = nil
            end
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local delta = hrp.Position - myHrp.Position
                    local rel = Vector2.new(delta.X, delta.Z)
                    local d = rel.Magnitude
                    if d < AR.radarRadius * 2 then
                        local ang = math.atan2(rel.X, rel.Y)
                        local rot = ang - camYaw
                        local px = math.sin(rot) * d
                        local pz = math.cos(rot) * d
                        local dot = radarDots[plr]
                        if not dot then
                            dot = Instance.new("Frame")
                            dot.Size = UDim2.fromOffset(6, 6)
                            dot.BackgroundColor3 = CONFIG.TeamRed
                            dot.BorderSizePixel = 0
                            dot.Parent = radarFrame
                            corner(dot, 3)
                            radarDots[plr] = dot
                        end
                        dot.Visible = true
                        dot.BackgroundColor3 = sameTeam(plr) and CONFIG.TeamBlue or CONFIG.TeamRed
                        dot.Position = UDim2.fromOffset(
                            AR.radarRadius + px - 3,
                            AR.radarRadius + pz - 3
                        )
                    end
                end
            end
        end
    end

    local hookedTools = {}
    local function applyWeaponMods(tool)
        if not tool or not tool:IsA("Tool") then return end
        if hookedTools[tool] then return end
        hookedTools[tool] = true

        local function zeroValue(v)
            if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
                if v.Name:find("Ammo") or v.Name:find("Clip") then
                    if AR.infiniteAmmo then
                        task.spawn(function()
                            while tool.Parent and AR.infiniteAmmo do
                                pcall(function() v.Value = 9999 end)
                                task.wait(0.5)
                            end
                        end)
                    end
                elseif v.Name:find("Recoil") or v.Name:find("Spread") or v.Name:find("Sway") then
                    pcall(function() v.Value = 0 end)
                elseif v.Name:find("Reload") and AR.fastReload then
                    pcall(function() v.Value = 0.01 end)
                end
            end
        end

        for _, d in ipairs(tool:GetDescendants()) do
            if d:IsA("NumberValue") or d:IsA("IntValue") then
                zeroValue(d)
            end
        end
        tool.ChildAdded:Connect(function(child)
            if child:IsA("NumberValue") or child:IsA("IntValue") then
                zeroValue(child)
            end
        end)
    end

    local function onCharacter(char)
        char.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then
                applyWeaponMods(child)
                arlog("tool equipped: " .. child.Name)
            end
        end)
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") then applyWeaponMods(child) end
        end
