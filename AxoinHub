local function buildBuildAnything(page, ctx)
    local Hub = ctx.Hub
    local BA = {
        running = false,
        placeDelay = 0,
        pivotBeforePlace = true,
        sessionStart = tick(),
        buildsRun = 0,
        blocksPlaced = 0,
        blocksDeleted = 0,
        lastAction = "idle",
        lastError = nil,
        victim = nil,
        debugLines = {},
    }
    local function balog(m)
        local t = os.date("%H:%M:%S")
        table.insert(BA.debugLines, string.format("[%s] %s", t, m))
        while #BA.debugLines > 14 do table.remove(BA.debugLines, 1) end
    end
    local function getPlaceRemote()
        local e = ReplicatedStorage:FindFirstChild("Events")
        return e and e:FindFirstChild("Place")
    end
    local function getDestroyRemote()
        local e = ReplicatedStorage:FindFirstChild("Events")
        return e and e:FindFirstChild("DestroyBlock")
    end
    local function placeBlock(blockName, cf)
        local remote = getPlaceRemote()
        if not remote then return false end
        local ok = pcall(function()
            remote:InvokeServer(blockName, cf, Workspace.Baseplate)
        end)
        if ok then BA.blocksPlaced = BA.blocksPlaced + 1 end
        return ok
    end
    local function rebuildFromTable(list, label)
        local char = LocalPlayer.Character
        if not char then balog("no character"); return end
        BA.lastAction = "building: " .. (label or "custom")
        BA.running = true
        local startCount = BA.blocksPlaced
        for i, entry in ipairs(list) do
            if not BA.running then break end
            local blockName = entry[1]
            local cf        = entry[2]
            if blockName and cf then
                if BA.pivotBeforePlace then
                    pcall(function() char:PivotTo(cf) end)
                end
                if BA.placeDelay > 0 then
                    task.wait(BA.placeDelay)
                else
                    task.wait()
                end
                pcall(placeBlock, blockName, cf)
            end
        end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = false end
        BA.running = false
        BA.buildsRun = BA.buildsRun + 1
        BA.lastAction = string.format("built %s (%d blocks)", label or "custom", BA.blocksPlaced - startCount)
        balog(BA.lastAction)
    end
    local function deletePlotFor(plotName)
        local destroy = getDestroyRemote()
        if not destroy then balog("DestroyBlock remote missing"); return 0 end
        local built = Workspace:FindFirstChild("Built")
        if not built then balog("Workspace.Built missing"); return 0 end
        local plot = plotName and built:FindFirstChild(plotName) or nil
        local count = 0
        if plot then
            for _, block in ipairs(plot:GetChildren()) do
                count = count + 1
                task.spawn(function()
                    pcall(function() destroy:InvokeServer(block) end)
                end)
            end
        else
            for _, p in ipairs(built:GetChildren()) do
                for _, block in ipairs(p:GetChildren()) do
                    count = count + 1
                    task.spawn(function()
                        pcall(function() destroy:InvokeServer(block) end)
                    end)
                end
            end
        end
        BA.blocksDeleted = BA.blocksDeleted + count
        BA.lastAction = "deleted " .. count .. " blocks"
        balog(BA.lastAction)
        return count
    end

    local registry = {}

    -- Subtovaehz: 12-wide ring at x=944, z from -968 to -924
    local t = {}
    for _, z in ipairs({-968, -964, -960, -956, -952, -948, -944, -940, -936, -932, -928, -924}) do
        table.insert(t, { "Cobblestone", CFrame.new(944, 2, z) })
    end
    for _, y in ipairs({6, 10, 14, 18, 22, 26, 30, 34, 38, 42, 46}) do
        table.insert(t, { "Cobblestone", CFrame.new(944, y, -968) })
        table.insert(t, { "Cobblestone", CFrame.new(944, y, -924) })
    end
    for _, z in ipairs({-964, -960, -956, -952, -948, -944, -940, -936, -932, -928}) do
        table.insert(t, { "Cobblestone", CFrame.new(944, 46, z) })
    end
    registry["Subtovaehz (ring)"] = t

    -- Castle: perimeter wall around x=200..228, z=-60..-184
    local castleT = {}
    local zs = {}
    for z = -60, -184, -4 do table.insert(zs, z) end
    for _, y in ipairs({2, 6, 10, 14, 18, 22, 26, 30, 34, 38}) do
        for _, z in ipairs(zs) do
            table.insert(castleT, { "Mossy Stone Blocks", CFrame.new(212, y, z) })
        end
    end
    registry["Castle (simple walls)"] = castleT

    -- Cool Pattern: concentric wool spiral
    local coolT = {}
    local cx, cz = 168, 152
    local colors = { "Magenta Wool", "Yellow Wool", "Cyan Wool", "Blue Wool", "Bricks" }
    local idx = 1
    for r = 20, 44, 4 do
        local c = colors[((idx - 1) % #colors) + 1]
        idx = idx + 1
        table.insert(coolT, { c, CFrame.new(cx, 2, cz + r) })
        table.insert(coolT, { c, CFrame.new(cx, 2, cz - r) })
        table.insert(coolT, { c, CFrame.new(cx + r, 2, cz) })
        table.insert(coolT, { c, CFrame.new(cx - r, 2, cz) })
    end
    registry["Cool Pattern (Wool)"] = coolT

    -- Claude's House V2: 4-wall outline + corner pillars + glass bands + pink trim
    local houseT = {}
    for x = 628, 660, 4 do
        table.insert(houseT, { "Cobblestone", CFrame.new(x, 2, 60) })
        table.insert(houseT, { "Cobblestone", CFrame.new(x, 2, 92) })
    end
    for z = 64, 88, 4 do
        table.insert(houseT, { "Cobblestone", CFrame.new(628, 2, z) })
        table.insert(houseT, { "Cobblestone", CFrame.new(660, 2, z) })
    end
    for _, y in ipairs({6, 10, 14}) do
        table.insert(houseT, { "Oak Log", CFrame.new(628, y, 60) })
        table.insert(houseT, { "Oak Log", CFrame.new(660, y, 60) })
        table.insert(houseT, { "Oak Log", CFrame.new(628, y, 92) })
        table.insert(houseT, { "Oak Log", CFrame.new(660, y, 92) })
    end
    for x = 636, 652, 8 do
        table.insert(houseT, { "Glass", CFrame.new(x, 10, 60) })
        table.insert(houseT, { "Glass", CFrame.new(x, 10, 92) })
    end
    for z = 68, 84, 8 do
        table.insert(houseT, { "Glass", CFrame.new(628, 10, z) })
        table.insert(houseT, { "Glass", CFrame.new(660, 10, z) })
    end
    for x = 628, 660, 4 do
        table.insert(houseT, { "Pink Wool", CFrame.new(x, 18, 60) })
        table.insert(houseT, { "Pink Wool", CFrame.new(x, 18, 92) })
    end
    registry["Claude's House V2"] = houseT

    Hub:AddSection(page, "Build — presets")
    for name, list in pairs(registry) do
        Hub:AddButton(page, "Build: " .. name .. " (" .. #list .. ")", function()
            task.spawn(function() rebuildFromTable(list, name) end)
        end)
    end

    Hub:AddSection(page, "Build — custom")
    local customBox = Hub:AddTextBox(page, 'paste: { {"Bricks", CFrame.new(100, 5, 100)}, ... }')
    Hub:AddButton(page, "Build from pasted table", function()
        local src = customBox.Text
        if #src < 10 then balog("paste too short"); return end
        local ok, tbl = pcall(function()
            local f = loadstring("return " .. src)
            return f and f()
        end)
        if ok and type(tbl) == "table" then
            task.spawn(function() rebuildFromTable(tbl, "custom") end)
            balog("custom build queued (" .. #tbl .. " blocks)")
        else
            balog("table parse failed: " .. tostring(tbl))
        end
    end)

    Hub:AddSection(page, "Delete")
    Hub:AddButton(page, "Delete ALL plots", function()
        task.spawn(function() deletePlotFor(nil) end)
    end)
    local victimBox = Hub:AddTextBox(page, "victim name (partial)")
    Hub:AddButton(page, "Lock victim", function()
        BA.victim = nil
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Name:lower():find(victimBox.Text:lower(), 1, true) then
                BA.victim = plr; break
            end
        end
        balog("victim set: " .. (BA.victim and BA.victim.Name or "none"))
    end)
    Hub:AddButton(page, "Delete locked victim plot", function()
        if not BA.victim then balog("no victim locked"); return end
        task.spawn(function() deletePlotFor(BA.victim.Name) end)
    end)

    Hub:AddSection(page, "Config")
    Hub:AddToggle(page, "Pivot char before each place", true, function(on) BA.pivotBeforePlace = on end)
    Hub:AddSlider(page, "Place delay (x10 ms)", 0, 50, 0, function(v) BA.placeDelay = v / 10 end)
    Hub:AddButton(page, "Stop current build", function()
        BA.running = false
        BA.lastAction = "stopped"
    end)

    Hub:AddSection(page, "Session")
    local statLbl = Instance.new("TextLabel")
    statLbl.Size = UDim2.new(1, 0, 0, 100); statLbl.BackgroundColor3 = CONFIG.BG2; statLbl.BorderSizePixel = 0
    statLbl.TextColor3 = CONFIG.Text; statLbl.Font = Enum.Font.Code; statLbl.TextSize = 11
    statLbl.TextXAlignment = Enum.TextXAlignment.Left; statLbl.TextYAlignment = Enum.TextYAlignment.Top
    statLbl.TextWrapped = true; statLbl.Text = "  session: loading..."; statLbl.Parent = page
    corner(statLbl, 6)
    local sp = Instance.new("UIPadding"); sp.PaddingTop = UDim.new(0, 6); sp.PaddingLeft = UDim.new(0, 8); sp.Parent = statLbl

    Hub:AddSection(page, "Debug")
    local debugLbl = Instance.new("TextLabel")
    debugLbl.Size = UDim2.new(1, 0, 0, 140); debugLbl.BackgroundColor3 = CONFIG.BG2; debugLbl.BorderSizePixel = 0
    debugLbl.TextColor3 = CONFIG.SubText; debugLbl.Font = Enum.Font.Code; debugLbl.TextSize = 9
    debugLbl.TextXAlignment = Enum.TextXAlignment.Left; debugLbl.TextYAlignment = Enum.TextYAlignment.Top
    debugLbl.TextWrapped = true; debugLbl.Text = "  debug: ready"; debugLbl.Parent = page
    corner(debugLbl, 6)
    local dp = Instance.new("UIPadding"); dp.PaddingTop = UDim.new(0, 6); dp.PaddingLeft = UDim.new(0, 8); dp.Parent = debugLbl

    State.Conn.baStats = task.spawn(function()
        while debugLbl and debugLbl.Parent do
            local elapsed = tick() - BA.sessionStart
            local mins = math.floor(elapsed / 60); local secs = math.floor(elapsed % 60)
            statLbl.Text = string.format(
                "  session: %02d:%02d\n  builds run: %d\n  blocks placed: %d\n  blocks deleted: %d\n  status: %s\n  victim: %s",
                mins, secs, BA.buildsRun, BA.blocksPlaced, BA.blocksDeleted,
                BA.lastAction, BA.victim and BA.victim.Name or "none")
            debugLbl.Text = #BA.debugLines > 0 and table.concat(BA.debugLines, "\n") or "  debug: ready"
            task.wait(0.35)
        end
    end)

    Hub:AddButton(page, "Reset counters", function()
        BA.buildsRun = 0; BA.blocksPlaced = 0; BA.blocksDeleted = 0
        BA.lastAction = "idle"; BA.lastError = nil; BA.debugLines = {}
    end)
end
