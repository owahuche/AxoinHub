    Hub:AddToggle(page, "Interactives", true, function(on) DR.espInteractives = on end)
    Hub:AddToggle(page, "Names + distance", true, function(on) DR.espNames = on; DR.espDistance = on end)
    Hub:AddSlider(page, "ESP range", 50, 1000, 500, function(v) DR.espRange = v end)

    Hub:AddSection(page, "Automation")
