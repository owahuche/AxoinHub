    end)

    State.Conn.arStats = task.spawn(function()
        while State.Conn.arHeartbeat do
            local elapsed = tick() - AR.sessionStart
            local mins = math.floor(elapsed / 60); local secs = math.floor(elapsed % 60)
            local ping = 0
            pcall(function() ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
            local targetName = AR.aimTarget and AR.aimTarget.player.Name or "none"
            statLbl.Text = string.format(
                "  session: %02d:%02d  ping: %.0fms\n  target: %s\n  shots: %d\n  aimbot: %s  silent: %s\n  trigger: %s  autofire: %s\n  esp: %s  radar: %s",
                mins, secs, ping, targetName, AR.shotsFired,
                tostring(AR.aimbot), tostring(AR.silentAim),
                tostring(AR.triggerBot), tostring(AR.autoFire),
                tostring(AR.espOn), tostring(AR.radarOn))
            debugLbl.Text = #AR.debugLines > 0 and table.concat(AR.debugLines, "\n") or "  debug: ready"
            task.wait(0.5)
