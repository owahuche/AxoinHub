    Hub:AddToggle(page, "Auto-hide on warning", false, function(on) DR.autoHide = on end)
    Hub:AddSlider(page, "Interact range", 5, 30, 12, function(v) DR.interactRange = v end)

    Hub:AddSection(page, "Movement")
    Hub:AddToggle(page, "Noclip", false, function(on) DR.noclip = on end)
    Hub:AddToggle(page, "Infinite jump", false, function(on) DR.infiniteJump = on end)
    Hub:AddToggle(page, "Fullbright", false, function(on) DR.fullbright = on; set_fullbright(on) end)
    Hub:AddSlider(page, "WalkSpeed", 16, 120, 20, function(v)
        local hum = MOD.getHum(); if hum then hum.WalkSpeed = v end
    end)

    Hub:AddSection(page, "Session")
    local statLbl = Instance.new("TextLabel")
    statLbl.Size = UDim2.new(1, 0, 0, 100); statLbl.BackgroundColor3 = CONFIG.BG2; statLbl.BorderSizePixel = 0
    statLbl.TextColor3 = CONFIG.Text; statLbl.Font = Enum.Font.Code; statLbl.TextSize = 11
    statLbl.TextXAlignment = Enum.TextXAlignment.Left; statLbl.TextYAlignment = Enum.TextYAlignment.Top
    statLbl.TextWrapped = true; statLbl.Text = "  session: loading..."; statLbl.Parent = page
    corner(statLbl, 6)
    local sp = Instance.new("UIPadding"); sp.PaddingTop = UDim.new(0, 6); sp.PaddingLeft = UDim.new(0, 8); sp.Parent = statLbl

    Hub:AddButton(page, "Clear ESP cache", function() clear_esp() end)

    State.Conn.doorsHeartbeat = RunService.Heartbeat:Connect(function()
        pcall(scan_world); pcall(auto_interact_tick); pcall(scan_rooms)
        if DR.noclip then
            local c = LocalPlayer.Character
            if c then for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
            end end
        end
        if DR.infiniteJump then
            local hum = MOD.getHum()
            if hum and hum:GetState() == Enum.HumanoidStateType.Freefall then
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
            end
        end
        for inst, entry in pairs(DR.espCache) do
            if not inst or not inst.Parent then remove_entry(entry); DR.espCache[inst] = nil end
        end
    end)
    State.Conn.doorsStats = task.spawn(function()
        while State.Conn.doorsHeartbeat do
            local elapsed = tick() - DR.sessionStart
            local mins = math.floor(elapsed / 60); local secs = math.floor(elapsed % 60)
            local entC, itmC = 0, 0
            for i in pairs(DR.entitySet) do if i and i.Parent then entC = entC + 1 end end
            for i in pairs(DR.itemSet) do if i and i.Parent then itmC = itmC + 1 end end
            statLbl.Text = string.format("  session: %02d:%02d\n  rooms: %d  current: %s\n  warnings: %d  interactions: %d\n  entities: %d  items: %d",
                mins, secs, DR.roomCount, DR.currentRoom, DR.entityWarnings, DR.interactions, entC, itmC)
            task.wait(0.5)
        end
    end)
end
