--=====================================================================
local function isInGame(name)
    local info = GAMES[name]; if not info then return false end
    for _, id in ipairs(info.PlaceIds) do if id == game.PlaceId then return true end end
    return false
end
local function joinAndRun(name)
    local info = GAMES[name]
    if not info or not info.JoinPlaceId then return false end
    _G.AXION_AUTORUN = name
    local payload = string.format("_G.AXION_AUTORUN = %q; loadstring(game:HttpGet(%q))()", name, CONFIG.SelfUrl)
    local queued = queueAfterTeleport(payload)
    if not queued then
        local warn = Instance.new("TextLabel")
        warn.Size = UDim2.new(1, 0, 0, 20); warn.BackgroundTransparency = 1
        warn.Font = Enum.Font.Gotham; warn.TextSize = 12; warn.TextColor3 = CONFIG.Danger
        warn.TextXAlignment = Enum.TextXAlignment.Left
        warn.Text = "  queue_on_teleport unavailable — re-exec hub on arrival"
        warn.Parent = State.Tabs["Games"].page
        task.delay(4, function() warn:Destroy() end)
    end
    pcall(function() TeleportService:Teleport(info.JoinPlaceId, LocalPlayer) end)
    return true
end
local function currentGameKey()
    local pid = game.PlaceId
    for name, info in pairs(GAMES) do
        for _, id in ipairs(info.PlaceIds) do
            if id == pid then return name, info end
        end
    end
    return nil, nil
end

