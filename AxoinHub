    local function rplog(m)
        local t = os.date("%H:%M:%S")
        table.insert(RP.debugLines, string.format("[%s] %s", t, m))
        while #RP.debugLines > 14 do table.remove(RP.debugLines, 1) end
    end
    local function read_ping()
        local ok, ping = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
        if ok and typeof(ping) == "number" then
            if RP.smoothedPing == 0 then RP.smoothedPing = ping
            else RP.smoothedPing = RP.smoothedPing * 0.7 + ping * 0.3 end
        end
        return RP.smoothedPing > 0 and RP.smoothedPing or 50
    end
    local function currentScanInterval()
        if not RP.pingAdaptive then return RP.scanInterval end
        local ping = RP.smoothedPing
        if ping <= 0 then return RP.scanInterval end
        local a = math.clamp((ping - 50) / 150, 0, 1)
        return RP.scanIntervalMin + (RP.scanIntervalMax - RP.scanIntervalMin) * a
    end
    local function cacheRanch()
        if RP.ranchCFrame then return end
        local r = MOD.getHRP()
        if r then RP.ranchCFrame = r.CFrame end
    end
    local function recacheRanch()
        local r = MOD.getHRP()
        if r then RP.ranchCFrame = r.CFrame; rplog("ranch recached") end
    end
    local function isBaseBL(part)
        if not part then return true end
        local c = LocalPlayer.Character
        if c and part:IsDescendantOf(c) then return true end
        if part:IsDescendantOf(LocalPlayer) then return true end
        local n = part.Name
        for _, bad in ipairs(RP.basePartBL) do
            if n == bad or n:find(bad) then return true end
        end
        return false
    end
    local function refreshBaseHull(force)
        if not RP.ranchCFrame then return end
        local now = tick()
        if not force and now - RP.baseHullUpdated < RP.baseRefresh then return end
        local center = RP.ranchCFrame.Position
        local parts, maxR = {}, 0
        pcall(function()
            for _, inst in ipairs(Workspace:GetDescendants()) do
                if inst:IsA("BasePart") and not isBaseBL(inst) then
                    local d = (inst.Position - center).Magnitude
                    if d <= RP.baseScanRadius then
                        table.insert(parts, inst)
                        if d > maxR then maxR = d end
                    end
                end
            end
        end)
        RP.baseHullParts = parts
        RP.baseHullCenter = center
        RP.baseHullRadius = maxR
        RP.baseHullUpdated = now
    end
    local function isInsideBase(eggPos)
        if not eggPos or not RP.ranchCFrame then return false end
        if (eggPos - RP.ranchCFrame.Position).Magnitude < RP.exclusionRadius then return true end
        if RP.baseHullCenter then
            if (eggPos - RP.baseHullCenter).Magnitude > RP.baseHullRadius + 20 then return false end
            for _, part in ipairs(RP.baseHullParts) do
                if part and part.Parent then
                    local local_pos = part.CFrame:PointToObjectSpace(eggPos)
                    local half = part.Size * 0.5 + Vector3.new(4, 4, 4)
                    if math.abs(local_pos.X) <= half.X
                    and math.abs(local_pos.Y) <= half.Y
                    and math.abs(local_pos.Z) <= half.Z then return true end
                end
            end
        end
        return false
    end
    local function nameIsBL(name)
        if not name then return false end
        for _, pat in ipairs(RP.placedEggBL) do
            if name:find(pat) then return true end
        end
        return false
    end
    local function isEgg(inst)
        if not inst then return false end
        if not (inst:IsA("Model") or inst:IsA("BasePart") or inst:IsA("Folder")) then return false end
        if nameIsBL(inst.Name) then return false end
        for _, pat in ipairs(RP.eggNamePatterns) do
            if inst.Name:find(pat) then return true end
        end
        return false
    end
    local function getPos(inst)
        if not inst then return nil end
        if inst:IsA("BasePart") then return inst.Position end
        if inst:IsA("Model") then
            if inst.PrimaryPart then return inst.PrimaryPart.Position end
            for _, d in ipairs(inst:GetDescendants()) do
                if d:IsA("BasePart") then return d.Position end
            end
        end
        return nil
    end
    local function isEligible(egg, eggPos)
        if not eggPos then return false end
        if isInsideBase(eggPos) then return false end
        if RP.ranchCFrame then
            if (eggPos - RP.ranchCFrame.Position).Magnitude < RP.minTargetDistance then return false end
        end
        local last = RP.attemptedTargets[egg]
        if last and (tick() - last) < RP.maxTargetAge then return false end
        return true
    end
    local function scoreTarget(eggPos, distToPlayer)
        local score = math.max(0, 500 - distToPlayer) * 0.4
        if RP.ranchCFrame then
            local baseDist = (eggPos - RP.ranchCFrame.Position).Magnitude
            score = score + math.min(baseDist, 500) * 0.6
        end
        return score
    end
    local function findBestEgg()
        local root = MOD.getHRP(); if not root then return nil end
        local best, bestScore = nil, -math.huge
        local skBase, skBl, skCool = 0, 0, 0
        pcall(function()
            for _, inst in ipairs(Workspace:GetDescendants()) do
                if isEgg(inst) then
                    local pos = getPos(inst)
                    if pos then
                        if nameIsBL(inst.Name) then
                            skBl = skBl + 1
                        else
                            local d = (pos - root.Position).Magnitude
                            if d <= RP.maxScanDistance then
                                if isInsideBase(pos) then
                                    skBase = skBase + 1
                                elseif not isEligible(inst, pos) then
                                    skCool = skCool + 1
                                else
                                    local score = scoreTarget(pos, d)
                                    if score > bestScore then best, bestScore = inst, score end
                                end
                            end
                        end
                    end
                end
            end
        end)
        RP.eggsBaseBlocked = skBase
        RP.eggsBlacklisted = skBl
        RP.eggsSkipped = skBase + skBl + skCool
        return best
    end
    local function eggIsGone(egg)
        if not egg then return true end
        if not egg.Parent then return true end
        if egg:IsDescendantOf(game:GetService("Players")) then return true end
        local p = egg.Parent
        while p do
            if p:IsA("Player") then return true end
            local n = p.Name:lower()
            if n:find("backpack") or n:find("inventory") then return true end
            p = p.Parent
        end
        return false
    end
    local function playerHoldsEgg()
        for _, inst in ipairs(LocalPlayer:GetDescendants()) do
            if isEgg(inst) then return true end
        end
        local c = LocalPlayer.Character
        if c then
            for _, inst in ipairs(c:GetDescendants()) do
                if isEgg(inst) then return true end
            end
        end
        return false
    end
    local function confirmCarry(egg)
        if not RP.carryConfirm then return true end
        local start = tick()
        task.wait(RP.carryWaitAfter)
        while tick() - start < RP.carryMaxWait do
            if not RP.running then return false end
            if eggIsGone(egg) or playerHoldsEgg() then return true end
            task.wait(RP.carryCheckInt)
        end
        return false
    end
    local function confirmPlaced()
        if not RP.carryConfirm then return true end
        local start = tick()
        task.wait(RP.placeWaitAfter)
        while tick() - start < RP.placeMaxWait do
            if not RP.running then return false end
            if not playerHoldsEgg() then return true end
            task.wait(RP.carryCheckInt)
        end
        return false
    end
    local function tpTo(pos)
        local r = MOD.getHRP(); if not r then return false end
        r.CFrame = CFrame.new(pos); return true
    end
    local function tpCF(cf)
        local r = MOD.getHRP(); if not r then return false end
        r.CFrame = cf; return true
    end
    local function tpVerify(targetPos, tol)
        local r = MOD.getHRP(); if not r then return false end
        tol = tol or RP.verifyTol
        task.wait(RP.verifyDelay)
        for i = 1, RP.maxResnaps do
            if not RP.running then return false end
            r = MOD.getHRP(); if not r then return false end
            local drift = (r.Position - targetPos).Magnitude
            if drift <= tol then return true end
            RP.teleportResnaps = RP.teleportResnaps + 1
            r.CFrame = CFrame.new(targetPos)
            task.wait(RP.resnapWait)
        end
        return false
    end
    local function tpWithDropBack(eggPos)
        local r = MOD.getHRP(); if not r then return end
        local drop = RP.dropBack or 0
        if drop <= 0 then tpTo(eggPos); tpVerify(eggPos); return end
        local dir = r.Position - eggPos
        if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) else dir = dir.Unit end
        local landing = eggPos + dir * drop
        tpTo(landing); tpVerify(landing)
    end
    local function tpApproach(eggPos)
        local r = MOD.getHRP(); if not r then return end
        local dist = (r.Position - eggPos).Magnitude
        if dist <= RP.promptRange then return end
        local steps = math.max(1, RP.approachSteps)
        local current = r.Position
        for i = 1, steps do
            if not RP.running then return end
            r = MOD.getHRP(); if not r then return end
            local remaining = (current - eggPos).Magnitude
            if remaining <= RP.promptRange then break end
            local targetDist = remaining - (remaining - RP.promptRange) / (steps - i + 1)
            targetDist = math.max(targetDist, RP.promptRange)
            local nextPos = eggPos + (current - eggPos).Unit * targetDist
            tpTo(nextPos)
            tpVerify(nextPos, RP.verifyTol * 1.5)
            current = nextPos
            task.wait(RP.approachStepDelay)
        end
    end
    local function snapFinal(eggPos)
        local r = MOD.getHRP(); if not r then return end
        local dir = r.Position - eggPos
        if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) else dir = dir.Unit end
        local landing = eggPos + dir * RP.finalOffset
        r.CFrame = CFrame.new(landing)
        if r:IsA("BasePart") then
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end
        local hum = MOD.getHum()
        if RP.humanoidReset and hum then
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
            task.wait(0.05)
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
        tpVerify(landing, RP.verifyTol)
    end
    local function tpReturn()
        if not RP.ranchCFrame then return false end
        tpCF(RP.ranchCFrame)
        return tpVerify(RP.ranchCFrame.Position, RP.verifyTol * 2)
    end
    local function getHoldDur(prompt)
        local d = RP.defaultHold
        pcall(function()
            if prompt and prompt:IsA("ProximityPrompt") then
                local hd = prompt.HoldDuration
                if typeof(hd) == "number" and hd > 0 then d = hd end
            end
        end)
        if d > RP.maxHold then d = RP.maxHold end
        return d
    end
    local function holdPromptFull(prompt, tag)
        if not prompt then return false end
        local hold = getHoldDur(prompt)
        local total = hold + RP.holdBuffer + RP.latencyPad
        RP.lastPromptHold = total
        local ok = pcall(function()
            prompt:InputHoldBegin()
            task.wait(RP.holdBeginWait)
            task.wait(total)
            prompt:InputHoldEnd()
            task.wait(RP.holdEndWait)
        end)
        return ok
    end
    local function legacyFire(prompt, tag)
        if not prompt then return false end
        local ok = pcall(function()
            prompt:InputHoldBegin()
            task.wait(RP.defaultHold + RP.latencyPad)
            prompt:InputHoldEnd()
        end)
        pcall(function() prompt.Triggered:Fire(LocalPlayer) end)
        return ok
    end
    local function touchSpam(egg, tag)
        local root = MOD.getHRP()
        if not egg or not root then return false end
        local target = egg
        if egg:IsA("Model") then
            for _, d in ipairs(egg:GetDescendants()) do
                if d:IsA("BasePart") then target = d; break end
            end
        end
        if not target or not target:IsA("BasePart") then return false end
        for i = 1, RP.touchSpamCount do
            pcall(function()
                target:FireTouchInterest(root, 0, 1)
                task.wait(RP.touchSpamDelay)
                target:FireTouchInterest(root, 1, 0)
            end)
            if not RP.running then return false end
        end
        return true
    end
    local function findPrompt(egg)
        if not egg then return nil end
        local p = egg:FindFirstChildOfClass("ProximityPrompt")
        if p then return p end
        for _, d in ipairs(egg:GetDescendants()) do
            if d:IsA("ProximityPrompt") then return d end
        end
        return nil
    end
    local function findClickDetector(egg)
        if not egg then return nil end
        for _, d in ipairs(egg:GetDescendants()) do
            if d:IsA("ClickDetector") then return d end
        end
        return nil
    end
    local function singleGrabAttempt(egg, n)
        if not egg or not egg.Parent then return false end
        local prompt = findPrompt(egg)
        if prompt then
            holdPromptFull(prompt, "a" .. n)
            task.wait(RP.grabVerifyDelay)
            if eggIsGone(egg) then RP.lastGrabStrategy = "hold"; return true end
            if RP.legacyFire then
                legacyFire(prompt, "a" .. n)
                task.wait(RP.grabVerifyDelay)
                if eggIsGone(egg) then RP.lastGrabStrategy = "legacy"; return true end
            end
            touchSpam(egg, "a" .. n)
            task.wait(RP.grabVerifyDelay)
            if eggIsGone(egg) then RP.lastGrabStrategy = "touch"; return true end
        end
        local cd = findClickDetector(egg)
        if cd then
            pcall(function() fireclickdetector(cd) end)
            task.wait(RP.grabVerifyDelay)
            if eggIsGone(egg) then RP.lastGrabStrategy = "click"; return true end
        end
        touchSpam(egg, "b" .. n)
        task.wait(RP.grabVerifyDelay)
        if eggIsGone(egg) then RP.lastGrabStrategy = "touch-part"; return true end
        return false
    end
    local function tryGrab(egg, eggPos)
        if not egg then return false end
        if RP.carryConfirm and RP.carrying then RP.carryBlocks = RP.carryBlocks + 1; return false end
        local total = 0
        for a = 1, RP.grabRetries do
            if not RP.running then return false end
            if not egg.Parent then return true end
            total = total + 1
            if singleGrabAttempt(egg, a) then RP.lastGrabAttempts = total; return true end
            task.wait(RP.grabRetryDelay)
        end
        if RP.reapproachOnFail and eggPos and egg.Parent then
            for r = 1, RP.reapproachAtt do
                if not RP.running then return false end
                if not egg.Parent then return true end
                snapFinal(eggPos)
                task.wait(RP.settleOnRetry)
                for a = 1, RP.grabRetries do
                    if not RP.running then return false end
                    if not egg.Parent then return true end
                    total = total + 1
                    if singleGrabAttempt(egg, a) then
                        RP.lastGrabAttempts = total
                        RP.eggsRecovered = RP.eggsRecovered + 1
                        return true
                    end
                    task.wait(RP.grabRetryDelay)
                end
            end
        end
        RP.lastGrabAttempts = total
        return false
    end
    local function placeEgg()
        if not RP.ranchCFrame then return false end
        local placed = false
        pcall(function()
            for _, d in ipairs(Workspace:GetDescendants()) do
                if d:IsA("ProximityPrompt") then
                    local txt = (d.ActionText or ""):lower()
                    for _, w in ipairs(RP.placeWords) do
                        if txt:find(w) then
                            local parent_pos = getPos(d.Parent)
                            if parent_pos and (parent_pos - RP.ranchCFrame.Position).Magnitude < 40 then
                                holdPromptFull(d, "place")
                                placed = true
                                return
                            end
                        end
                    end
                end
            end
        end)
        return placed
    end
    local function autofarmLoop()
        cacheRanch()
        refreshBaseHull(true)
        rplog("autofarm loop started")
        while RP.running do
            local root = MOD.getHRP()
            if not root then task.wait(0.2); continue end
            read_ping(); refreshBaseHull()
            if RP.carryConfirm and RP.carrying then
                RP.lastAction = "waiting for carry confirm"
                local ok = confirmCarry(RP.carryEgg)
                if not ok then
                    RP.carryBlocks = RP.carryBlocks + 1
                    RP.carrying = false; RP.carryEgg = nil
                end
                task.wait(RP.phaseSettleShort)
                if not RP.running then break end
            end
            RP.loops = RP.loops + 1
            RP.lastAction = "scanning"
            task.wait(currentScanInterval())
            if not RP.running then break end
            local egg = findBestEgg()
            if not egg then RP.lastAction = "no eligible egg"; task.wait(0.4); continue end
            RP.eggsFound = RP.eggsFound + 1
            RP.currentTarget = egg
            RP.lastAction = "egg found"
            rplog("egg found: " .. egg.Name)
            task.wait(RP.phaseSettleShort)
            if not RP.running then break end
            local eggPos = getPos(egg)
            if not eggPos then RP.lastError = "egg has no position"; task.wait(0.2); continue end
            if isInsideBase(eggPos) then
                RP.lastAction = "target inside base — skipping"
                RP.attemptedTargets[egg] = tick()
                task.wait(RP.phaseSettleShort); continue
            end
            local drop = math.floor(RP.dropBack or 0)
            RP.lastAction = drop > 0 and string.format("drop-back %d", drop) or "teleport egg"
            pcall(tpWithDropBack, eggPos)
            task.wait(RP.phaseSettleShort)
            if not RP.running then break end
            if drop > 0 then
                RP.lastAction = "approach"
                pcall(tpApproach, eggPos)
                task.wait(RP.phaseSettleShort)
            end
            if not RP.running then break end
            RP.lastAction = "final snap"
            pcall(snapFinal, eggPos)
            task.wait(RP.phaseSettleShort)
            if not RP.running then break end
            RP.lastAction = "grabbing"
            local grabbed = false
            pcall(function() grabbed = tryGrab(egg, eggPos) end)
            if grabbed then
                RP.eggsGrabbed = RP.eggsGrabbed + 1
                RP.carrying = true; RP.carryEgg = egg
                RP.lastAction = "grabbed via " .. tostring(RP.lastGrabStrategy)
                rplog("grabbed via " .. tostring(RP.lastGrabStrategy) .. " in " .. tostring(RP.lastGrabAttempts) .. " attempts")
                RP.attemptedTargets[egg] = tick()
                confirmCarry(egg)
            else
                RP.eggsFailed = RP.eggsFailed + 1
                RP.attemptedTargets[egg] = tick()
                RP.lastAction = "grab failed"
                rplog("grab FAILED after " .. tostring(RP.lastGrabAttempts) .. " attempts")
            end
            task.wait(RP.postGrabSettle)
            if not RP.running then break end
            if RP.ranchCFrame and grabbed then
                RP.lastAction = "return"
                pcall(tpReturn)
                task.wait(RP.phaseSettleLong)
                if RP.autoPlace and RP.running then
                    RP.lastAction = "placing"
                    local okPlace = false
                    pcall(function() okPlace = placeEgg() end)
                    if okPlace then RP.eggsPlaced = RP.eggsPlaced + 1 end
                    confirmPlaced()
                    RP.carrying = false; RP.carryEgg = nil
                    rplog("place cycle complete")
                    task.wait(RP.phaseSettleShort)
                else
                    RP.carrying = false; RP.carryEgg = nil
                end
            end
            RP.currentTarget = nil
        end
        RP.lastAction = "stopped"
        rplog("autofarm loop stopped")
    end

