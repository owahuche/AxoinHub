        baseHullCenter = nil, baseHullRadius = 0, baseHullParts = {}, baseHullUpdated = 0,
        currentTarget = nil, attemptedTargets = {},
        eggsFound = 0, eggsGrabbed = 0, eggsPlaced = 0,
        eggsSkipped = 0, eggsFailed = 0, eggsRecovered = 0,
