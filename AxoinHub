--=====================================================================
-- MM2 MODULE
--=====================================================================
local function buildMM2(page, ctx)
    local Hub = ctx.Hub
    local MM = {
        espOn = true, espMurderer = true, espSheriff = true, espInnocents = true,
        espGuns = true, espKnives = true, espCoins = true,
        espBoxes = true, espNames = true, espDistance = true, espTracers = false,
        espRange = 500,
        autoCoin = false, coinRange = 60,
        autoPickup = false, pickupRange = 12,
        proximityAlert = false, alertDistance = 50, alertsFired = 0,
        autoShoot = false, shootInterval = 0.3,
        autoStab = false,  stabInterval = 0.5,
        infiniteJump = false, fullbright = false, walkSpeed = 16,
        sessionStart = tick(),
        lastAction = "idle",
        lastPickupAt = 0, lastAttackAt = 0,
        myRole = "unknown", murdererName = nil, sheriffName = nil,
        playerRoleCache = {}, playerEspCache = {}, itemEspCache = {},
        coinSet = {}, gunSet = {}, knifeSet = {},
        debugLines = {},
    }
    local function mmlog(m)
        local t = os.date("%H:%M:%S")
        table.insert(MM.debugLines, string.format("[%s] %s", t, m))
        while #MM.debugLines > 12 do table.remove(MM.debugLines, 1) end
    end
    local function role_of(plr)
        if not plr or not plr.Character then return "innocent" end
        for _, tool in ipairs(plr.Character:GetChildren()) do
            if tool:IsA("Tool") then
                local n = tool.Name:lower()
                if n:find("knife") then return "murderer" end
                if n:find("gun") or n:find("revolver") or n:find("pistol") then return "sheriff" end
            end
        end
        return "innocent"
    end
    local function refresh_roles()
        MM.murdererName = nil; MM.sheriffName = nil; MM.playerRoleCache = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            local r = role_of(plr)
            MM.playerRoleCache[plr] = r
            if r == "murderer" then MM.murdererName = plr.Name
            elseif r == "sheriff" then MM.sheriffName = plr.Name end
        end
        MM.myRole = MM.playerRoleCache[LocalPlayer] or "innocent"
    end
    local function isGun(inst)
        local n = inst and inst.Name:lower() or ""
        return n:find("gun") or n:find("revolver") or n:find("pistol")
    end
    local function isKnife(inst)
        local n = inst and inst.Name:lower() or ""
        return n:find("knife") or n:find("dagger") or n:find("blade")
    end
    local function isCoin(inst)
        local n = inst and inst.Name:lower() or ""
        return n == "coin" or n:find("coin") or n:find("money")
    end
    local function get_pos(inst)
        if not inst then return nil end
        if inst:IsA("BasePart") then return inst.Position end
        if inst:IsA("Model") then
            local p = inst.PrimaryPart; if p then return p.Position end
            for _, d in ipairs(inst:GetDescendants()) do if d:IsA("BasePart") then return d.Position end end
        end
        if inst:IsA("Tool") then
            local h = inst:FindFirstChildWhichIsA("BasePart"); if h then return h.Position end
        end
        return nil
    end
    local HAS_DRAWING = (Drawing ~= nil)
    local function new_drawing(class, props)
        if not HAS_DRAWING then return nil end
        local d = Drawing.new(class)
        for k, v in pairs(props) do d[k] = v end
        return d
    end
    local function make_entry(color, with_tracer)
        if not HAS_DRAWING then return nil end
        local e = {
            box  = new_drawing("Square", { Thickness = 1, Color = color, Filled = false, Transparency = 0.9 }),
            name = new_drawing("Text", { Text = "", Size = 13, Center = true, Outline = true, Color = Color3.new(1,1,1), Font = 2 }),
            dist = new_drawing("Text", { Text = "", Size = 11, Center = true, Outline = true, Color = color, Font = 2 }),
        }
        if with_tracer then
            e.tracer = new_drawing("Line", { Thickness = 1, Color = color, Transparency = 0.5 })
        end
        return e
    end
    local function entry_remove(e)
        if not e then return end
        for _, o in pairs(e) do pcall(function() o:Remove() end) end
    end
    local ROLE_COLOR = { murderer = CONFIG.MurderRed, sheriff = CONFIG.SheriffBlue, innocent = CONFIG.InnocentGrn }
    local ROLE_PREFIX = { murderer = "[MURDERER]", sheriff = "[SHERIFF]", innocent = "[INNOCENT]" }
    local function draw_player(plr)
        if not MM.espOn then return end
        local role = MM.playerRoleCache[plr] or "innocent"
        if role == "murderer" and not MM.espMurderer then return end
        if role == "sheriff" and not MM.espSheriff then return end
        if role == "innocent" and not MM.espInnocents then return end
        local char = plr.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end
        local myHrp = MOD.getHRP(); if not myHrp then return end
        local dist = (hrp.Position - myHrp.Position).Magnitude
        if dist > MM.espRange then return end
        local cam = Workspace.CurrentCamera; if not cam then return end
        local sp, on_screen = cam:WorldToViewportPoint(hrp.Position)
        if not on_screen then return end
        if not MM.playerEspCache[plr] then
            MM.playerEspCache[plr] = make_entry(ROLE_COLOR[role] or CONFIG.Accent, true)
        end
        local e = MM.playerEspCache[plr]; if not e then return end
        local scale = 1 / math.max(dist, 1) * 500
        local w = math.max(8,  3 * scale * 0.5)
        local h = math.max(12, 5 * scale * 0.5)
        e.box.Visible = MM.espBoxes; e.box.Color = ROLE_COLOR[role] or CONFIG.Accent
        e.box.Size = Vector2.new(w, h); e.box.Position = Vector2.new(sp.X - w/2, sp.Y - h/2)
        e.name.Visible = MM.espNames; e.name.Position = Vector2.new(sp.X, sp.Y - h/2 - 16)
        e.name.Text = (ROLE_PREFIX[role] or "") .. " " .. plr.Name
        e.dist.Visible = MM.espDistance; e.dist.Position = Vector2.new(sp.X, sp.Y + h/2 + 2)
        e.dist.Text = string.format("%dm", math.floor(dist)); e.dist.Color = ROLE_COLOR[role] or CONFIG.Accent
        if e.tracer then
            e.tracer.Visible = MM.espTracers
            e.tracer.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
            e.tracer.To = Vector2.new(sp.X, sp.Y + h/2)
            e.tracer.Color = ROLE_COLOR[role] or CONFIG.Accent
        end
    end
    local function draw_item(inst, tag)
        if not MM.espOn then return end
        if tag == "gun" and not MM.espGuns then return end
        if tag == "knife" and not MM.espKnives then return end
        if tag == "coin" and not MM.espCoins then return end
        local pos = get_pos(inst); local myHrp = MOD.getHRP()
        if not pos or not myHrp then return end
        local dist = (pos - myHrp.Position).Magnitude
        if dist > MM.espRange then return end
        local cam = Workspace.CurrentCamera; if not cam then return end
        local sp, on_screen = cam:WorldToViewportPoint(pos)
        if not on_screen then return end
        local color
        if tag == "gun" then color = CONFIG.SheriffBlue
        elseif tag == "knife" then color = CONFIG.MurderRed
        elseif tag == "coin" then color = CONFIG.CoinGold
        else color = Color3.fromRGB(255, 130, 200) end
        if not MM.itemEspCache[inst] then MM.itemEspCache[inst] = make_entry(color, false) end
        local e = MM.itemEspCache[inst]; if not e then return end
        local scale = 1 / math.max(dist, 1) * 500
        local w = math.max(8,  2 * scale * 0.5)
        local h = math.max(12, 2 * scale * 0.5)
        e.box.Visible = MM.espBoxes; e.box.Color = color
        e.box.Size = Vector2.new(w, h); e.box.Position = Vector2.new(sp.X - w/2, sp.Y - h/2)
        e.name.Visible = MM.espNames; e.name.Position = Vector2.new(sp.X, sp.Y - h/2 - 16)
        e.name.Text = "[" .. tag:upper() .. "] " .. inst.Name
        e.dist.Visible = MM.espDistance; e.dist.Position = Vector2.new(sp.X, sp.Y + h/2 + 2)
        e.dist.Text = string.format("%dm", math.floor(dist)); e.dist.Color = color
    end
    local function scan_items()
        MM.gunSet = {}; MM.knifeSet = {}; MM.coinSet = {}
        for _, inst in ipairs(Workspace:GetDescendants()) do
            if inst:IsA("BasePart") or inst:IsA("Tool") or inst:IsA("Model") then
                local insideChar = false
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr.Character and inst:IsDescendantOf(plr.Character) then insideChar = true; break end
                end
                if not insideChar then
                    local tag = nil
                    if isGun(inst) then tag = "gun"
                    elseif isKnife(inst) then tag = "knife"
                    elseif isCoin(inst) then tag = "coin" end
                    if tag then
                        if tag == "gun" then MM.gunSet[inst] = true
                        elseif tag == "knife" then MM.knifeSet[inst] = true
                        elseif tag == "coin" then MM.coinSet[inst] = true end
                        pcall(draw_item, inst, tag)
                    end
                end
            end
        end
    end
    local function auto_coin_tick()
        if not MM.autoCoin then return end
        local hum = MOD.getHum(); if not hum then return end
        local myHrp = MOD.getHRP(); if not myHrp then return end
        local best, bestd = nil, MM.coinRange
        for inst, _ in pairs(MM.coinSet) do
            if inst and inst.Parent then
                local p = get_pos(inst)
                if p then
                    local d = (p - myHrp.Position).Magnitude
                    if d < bestd then best, bestd = inst, d end
                end
            end
        end
        if best then
            local p = get_pos(best)
            if p then hum:MoveTo(p); MM.lastAction = "walking to coin" end
        end
    end
    local function auto_pickup_tick()
        if not MM.autoPickup then return end
        local myHrp = MOD.getHRP(); if not myHrp then return end
        local now = tick(); if now - MM.lastPickupAt < 0.3 then return end
        MM.lastPickupAt = now
        for inst, _ in pairs(MM.gunSet) do
            if inst and inst.Parent then
                local p = get_pos(inst)
                if p and (p - myHrp.Position).Magnitude < MM.pickupRange then
                    local handle = inst:FindFirstChildWhichIsA("BasePart") or (inst:IsA("BasePart") and inst)
                    if handle and FEATURES.firetouch then
                        pcall(function() firetouchinterest(myHrp, handle, 0) end)
                        pcall(function() firetouchinterest(myHrp, handle, 1) end)
                        mmlog("pickup gun " .. inst.Name)
                    end
                end
            end
        end
        for inst, _ in pairs(MM.knifeSet) do
            if inst and inst.Parent then
                local p = get_pos(inst)
                if p and (p - myHrp.Position).Magnitude < MM.pickupRange then
                    local handle = inst:FindFirstChildWhichIsA("BasePart") or (inst:IsA("BasePart") and inst)
                    if handle and FEATURES.firetouch then
                        pcall(function() firetouchinterest(myHrp, handle, 0) end)
                        pcall(function() firetouchinterest(myHrp, handle, 1) end)
                        mmlog("pickup knife " .. inst.Name)
                    end
                end
            end
        end
    end
    local function auto_shoot_tick()
        if not MM.autoShoot then return end
        if MM.myRole ~= "sheriff" then return end
        if not MM.murdererName then return end
        local murderer = Players:FindFirstChild(MM.murdererName)
        if not murderer or not murderer.Character then return end
        local tHrp = murderer.Character:FindFirstChild("HumanoidRootPart")
        if not tHrp then return end
        local now = tick(); if now - MM.lastAttackAt < MM.shootInterval then return end
        MM.lastAttackAt = now
        local cam = Workspace.CurrentCamera
        if cam then cam.CFrame = CFrame.new(cam.CFrame.Position, tHrp.Position) end
        local tool = MOD.getTool()
        if tool and tool.Name:lower():find("gun") then
            pcall(function() tool:Activate() end)
            MM.lastAction = "shoot: " .. murderer.Name
        end
    end
    local function auto_stab_tick()
        if not MM.autoStab then return end
        if MM.myRole ~= "murderer" then return end
        local myHrp = MOD.getHRP(); if not myHrp then return end
        local now = tick(); if now - MM.lastAttackAt < MM.stabInterval then return end
        local best, bestd = nil, 15
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local role = MM.playerRoleCache[plr] or "innocent"
                if role ~= "murderer" then
                    local tHrp = plr.Character:FindFirstChild("HumanoidRootPart")
                    local hum  = plr.Character:FindFirstChildOfClass("Humanoid")
                    if tHrp and hum and hum.Health > 0 then
                        local d = (tHrp.Position - myHrp.Position).Magnitude
                        if d < bestd then best, bestd = plr, d end
                    end
                end
            end
        end
        if not best then return end
        MM.lastAttackAt = now
        local tHrp = best.Character:FindFirstChild("HumanoidRootPart")
        if tHrp then
            if bestd > 4 then MOD.physicsTP(CFrame.new(tHrp.Position + Vector3.new(0, 0, 2))) end
            task.wait(0.08)
            local tool = MOD.getTool()
            if tool and tool.Name:lower():find("knife") then
                pcall(function() tool:Activate() end)
                MM.lastAction = "stab: " .. best.Name
            end
        end
    end
    local lastAlert = 0
    local function alert_tick()
        if not MM.proximityAlert then return end
        if MM.myRole == "murderer" then return end
        if not MM.murdererName then return end
        local murderer = Players:FindFirstChild(MM.murdererName)
        if not murderer or not murderer.Character then return end
        local tHrp = murderer.Character:FindFirstChild("HumanoidRootPart")
        local myHrp = MOD.getHRP()
        if not tHrp or not myHrp then return end
        local d = (tHrp.Position - myHrp.Position).Magnitude
        if d < MM.alertDistance then
            local now = tick()
            if now - lastAlert > 3 then
                lastAlert = now
                MM.alertsFired = MM.alertsFired + 1
                MM.lastAction = "MURDERER NEAR: " .. murderer.Name
                mmlog("ALERT: murderer within " .. math.floor(d) .. "m")
                local sound = Instance.new("Sound")
                sound.SoundId = "rbxasset://sounds/electronicpingshort.wav"
                sound.Volume = 1; sound.Parent = SoundService; sound:Play()
                task.delay(1, function() sound:Destroy() end)
            end
        end
    end
    local savedLight = nil
    local function set_fullbright(on)
        if on then
            if not savedLight then
                savedLight = { Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
                    Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime, FogEnd = Lighting.FogEnd }
            end
            Lighting.Ambient = Color3.fromRGB(180,180,180); Lighting.OutdoorAmbient = Color3.fromRGB(180,180,180)
            Lighting.Brightness = 3; Lighting.ClockTime = 14; Lighting.FogEnd = 1e6
        elseif savedLight then
            for k, v in pairs(savedLight) do pcall(function() Lighting[k] = v end) end
            savedLight = nil
        end
    end

    Hub:AddSection(page, "ESP — players")
    Hub:AddToggle(page, "Master ESP", true, function(on)
        MM.espOn = on
        if not on then
            for _, e in pairs(MM.playerEspCache) do entry_remove(e) end
            for _, e in pairs(MM.itemEspCache) do entry_remove(e) end
            MM.playerEspCache = {}; MM.itemEspCache = {}
        end
    end)
    Hub:AddToggle(page, "Show murderer (red)", true, function(on) MM.espMurderer = on end)
    Hub:AddToggle(page, "Show sheriff (blue)", true, function(on) MM.espSheriff = on end)
    Hub:AddToggle(page, "Show innocents (green)", true, function(on) MM.espInnocents = on end)
    Hub:AddToggle(page, "Boxes", true, function(on) MM.espBoxes = on end)
    Hub:AddToggle(page, "Names + distance", true, function(on) MM.espNames = on; MM.espDistance = on end)
    Hub:AddToggle(page, "Tracers", false, function(on) MM.espTracers = on end)

    Hub:AddSection(page, "ESP — items")
    Hub:AddToggle(page, "Guns (blue)", true, function(on) MM.espGuns = on end)
    Hub:AddToggle(page, "Knives (red)", true, function(on) MM.espKnives = on end)
    Hub:AddToggle(page, "Coins (gold)", true, function(on) MM.espCoins = on end)
    Hub:AddSlider(page, "ESP range", 50, 1000, 500, function(v) MM.espRange = v end)

    Hub:AddSection(page, "Auto coin / pickup")
    Hub:AddToggle(page, "Auto coin (walk)", false, function(on) MM.autoCoin = on end)
    Hub:AddSlider(page, "Coin range", 10, 300, 60, function(v) MM.coinRange = v end)
    Hub:AddToggle(page, "Auto pickup (guns/knives)", false, function(on) MM.autoPickup = on end)
    Hub:AddSlider(page, "Pickup range", 5, 40, 12, function(v) MM.pickupRange = v end)

    Hub:AddSection(page, "Combat")
    Hub:AddToggle(page, "Auto-shoot (sheriff)", false, function(on) MM.autoShoot = on end)
    Hub:AddSlider(page, "Shoot interval (x100ms)", 10, 200, 30, function(v) MM.shootInterval = v / 100 end)
    Hub:AddToggle(page, "Auto-stab (murderer)", false, function(on) MM.autoStab = on end)
    Hub:AddSlider(page, "Stab interval (x100ms)", 10, 200, 50, function(v) MM.stabInterval = v / 100 end)

    Hub:AddSection(page, "Proximity alert")
    Hub:AddToggle(page, "Alert when murderer near", false, function(on) MM.proximityAlert = on end)
    Hub:AddSlider(page, "Alert distance", 10, 200, 50, function(v) MM.alertDistance = v end)

    Hub:AddSection(page, "Movement")
    Hub:AddToggle(page, "Infinite jump (airborne only)", false, function(on)
        MM.infiniteJump = on
        if State.Conn.mmInfJump then State.Conn.mmInfJump:Disconnect(); State.Conn.mmInfJump = nil end
        if not on then return end
        State.Conn.mmInfJump = UserInputService.JumpRequest:Connect(function()
            local hum = MOD.getHum()
            if hum and hum.FloorMaterial == Enum.Material.Air then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    end)
    Hub:AddToggle(page, "Fullbright", false, function(on) MM.fullbright = on; set_fullbright(on) end)
    Hub:AddSlider(page, "WalkSpeed", 16, 100, 16, function(v)
        MM.walkSpeed = v
        local hum = MOD.getHum(); if hum then hum.WalkSpeed = v end
    end)

    Hub:AddSection(page, "Session")
    local statLbl = Instance.new("TextLabel")
    statLbl.Size = UDim2.new(1, 0, 0, 140); statLbl.BackgroundColor3 = CONFIG.BG2; statLbl.BorderSizePixel = 0
    statLbl.TextColor3 = CONFIG.Text; statLbl.Font = Enum.Font.Code; statLbl.TextSize = 11
    statLbl.TextXAlignment = Enum.TextXAlignment.Left; statLbl.TextYAlignment = Enum.TextYAlignment.Top
    statLbl.TextWrapped = true; statLbl.Text = "  session: loading..."; statLbl.Parent = page
    corner(statLbl, 6)
    local sp = Instance.new("UIPadding"); sp.PaddingTop = UDim.new(0, 6); sp.PaddingLeft = UDim.new(0, 8); sp.Parent = statLbl

    Hub:AddSection(page, "Debug")
    local debugLbl = Instance.new("TextLabel")
    debugLbl.Size = UDim2.new(1, 0, 0, 120); debugLbl.BackgroundColor3 = CONFIG.BG2; debugLbl.BorderSizePixel = 0
    debugLbl.TextColor3 = CONFIG.SubText; debugLbl.Font = Enum.Font.Code; debugLbl.TextSize = 10
    debugLbl.TextXAlignment = Enum.TextXAlignment.Left; debugLbl.TextYAlignment = Enum.TextYAlignment.Top
    debugLbl.TextWrapped = true; debugLbl.Text = "  debug: ready"; debugLbl.Parent = page
    corner(debugLbl, 6)
    local dp = Instance.new("UIPadding"); dp.PaddingTop = UDim.new(0, 6); dp.PaddingLeft = UDim.new(0, 8); dp.Parent = debugLbl

    Hub:AddButton(page, "Refresh roles", function() refresh_roles(); mmlog("roles refreshed") end)

    State.Conn.mmHeartbeat = RunService.Heartbeat:Connect(function()
        if not MM.lastRoleAt or tick() - MM.lastRoleAt > 1.5 then
            MM.lastRoleAt = tick()
            pcall(refresh_roles)
        end
        if not MM.lastScanAt or tick() - MM.lastScanAt > 0.5 then
            MM.lastScanAt = tick()
            pcall(scan_items)
        end
        if MM.espOn then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then pcall(draw_player, plr) end
            end
        end
        for inst in pairs(MM.gunSet) do pcall(draw_item, inst, "gun") end
        for inst in pairs(MM.knifeSet) do pcall(draw_item, inst, "knife") end
        for inst in pairs(MM.coinSet) do pcall(draw_item, inst, "coin") end
        for plr, e in pairs(MM.playerEspCache) do
            if not plr or not plr.Parent then entry_remove(e); MM.playerEspCache[plr] = nil end
        end
        for inst, e in pairs(MM.itemEspCache) do
            if not inst or not inst.Parent then entry_remove(e); MM.itemEspCache[inst] = nil end
        end
        pcall(auto_coin_tick); pcall(auto_pickup_tick); pcall(auto_shoot_tick)
        pcall(auto_stab_tick); pcall(alert_tick)
    end)
    State.Conn.mmStats = task.spawn(function()
        while State.Conn.mmHeartbeat do
            local elapsed = tick() - MM.sessionStart
            local mins = math.floor(elapsed / 60); local secs = math.floor(elapsed % 60)
            local ping = 0
            pcall(function() ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
            statLbl.Text = string.format(
                "  session: %02d:%02d  ping: %.0fms\n  my role: %s\n  murderer: %s\n  sheriff: %s\n  alerts: %d\n  last: %s",
                mins, secs, ping, MM.myRole:upper(),
                MM.murdererName or "?", MM.sheriffName or "?",
                MM.alertsFired, MM.lastAction)
            debugLbl.Text = #MM.debugLines > 0 and table.concat(MM.debugLines, "\n") or "  debug: ready"
            task.wait(0.5)
        end
    end)
end
