--=====================================================================
local function buildDoors(page, ctx)
    local Hub = ctx.Hub
    local DR = {
        espOn = true, espEntities = true, espItems = true, espInteractives = true,
        espNames = true, espDistance = true, espRange = 500,
        autoInteract = false, interactRange = 12, interactInterval = 0.4,
        autoHide = false,
        fullbright = false, noclip = false, infiniteJump = false,
        sessionStart = tick(), lastInteract = 0, lastScan = 0,
        roomCount = 0, currentRoom = "?", roomsSeen = {},
        entityWarnings = 0, interactions = 0,
        entitySet = {}, itemSet = {}, espCache = {},
    }
    local ENTITY_NAMES = { "Rush","Ambush","Eyes","Screech","Dupe","Hide","Jack","Shadow","Timothy","Snare","Glitch","Seek","Figure","Halt","Window","Void","Guiding Light","El Goblino" }
    local ITEM_NAMES   = { "Key","Lockpick","Candle","Lighter","Vitamins","Crucifix","Flashlight","Battery","Bandage","Skeleton Key","Gold Key","Room Key","Door Key","Skull Key" }
    local INTERACT_NAMES = { "Door","Lever","Button","Drawer","Cabinet","Chest","Painting","Note","Paper","Code","Safe","Switch" }

    local function name_contains(name, list)
        local n = name:lower()
        for _, v in ipairs(list) do if n:find(v:lower(), 1, true) then return true end end
        return false
    end
    local function classify(inst)
        if not inst then return nil end
        local n = inst.Name
        if name_contains(n, ENTITY_NAMES)   then return "entity" end
        if name_contains(n, ITEM_NAMES)     then return "item" end
        if name_contains(n, INTERACT_NAMES) then return "interactive" end
        return nil
    end
    local function get_pos(inst)
        if not inst then return nil end
        if inst:IsA("BasePart") then return inst.Position end
        if inst:IsA("Model") then
            local p = inst.PrimaryPart; if p then return p.Position end
            for _, d in ipairs(inst:GetDescendants()) do if d:IsA("BasePart") then return d.Position end end
        end
        return nil
    end
    local function get_size(inst)
        if not inst then return Vector3.new(3,3,3) end
        if inst:IsA("BasePart") then return inst.Size end
        if inst:IsA("Model") then
            local ok, _, size = pcall(function() return inst:GetBoundingBox() end)
            if ok and size then return size end
        end
        return Vector3.new(3,3,3)
    end
    local HAS_DRAWING = (Drawing ~= nil)
    local function new_drawing(class, props)
        if not HAS_DRAWING then return nil end
        local d = Drawing.new(class)
        for k, v in pairs(props) do d[k] = v end
        return d
    end
    local function esp_entry(inst, tag)
        if DR.espCache[inst] then return DR.espCache[inst] end
        if not HAS_DRAWING then return nil end
        local color = CONFIG.Accent
        if tag == "entity" then color = CONFIG.Danger
        elseif tag == "item" then color = CONFIG.Safe
        elseif tag == "interactive" then color = CONFIG.Warn end
        local e = {
            box  = new_drawing("Square", { Thickness = 1, Color = color, Filled = false, Transparency = 0.9 }),
            name = new_drawing("Text", { Text = "", Size = 13, Center = true, Outline = true, Color = Color3.new(1,1,1), Font = 2 }),
            dist = new_drawing("Text", { Text = "", Size = 11, Center = true, Outline = true, Color = color, Font = 2 }),
        }
        DR.espCache[inst] = e
        return e
    end
    local function hide_entry(e)
        if not e then return end
        for _, o in pairs(e) do pcall(function() o.Visible = false end) end
    end
    local function remove_entry(e)
        if not e then return end
        for _, o in pairs(e) do pcall(function() o:Remove() end) end
    end
    local function clear_esp()
        for _, e in pairs(DR.espCache) do remove_entry(e) end
        DR.espCache = {}
    end
    local function draw_esp(inst, tag)
        if not DR.espOn then return end
        if tag == "entity" and not DR.espEntities then hide_entry(DR.espCache[inst]); return end
        if tag == "item" and not DR.espItems then hide_entry(DR.espCache[inst]); return end
        if tag == "interactive" and not DR.espInteractives then hide_entry(DR.espCache[inst]); return end
        local pos = get_pos(inst); local hrp = MOD.getHRP()
        if not pos or not hrp then return end
        local dist = (pos - hrp.Position).Magnitude
        if dist > DR.espRange then hide_entry(DR.espCache[inst]); return end
        local cam = Workspace.CurrentCamera; if not cam then return end
        local sp, on_screen = cam:WorldToViewportPoint(pos)
        if not on_screen then hide_entry(DR.espCache[inst]); return end
        local e = esp_entry(inst, tag); if not e then return end
        local size = get_size(inst)
        local scale = 1 / math.max(dist, 1) * 500
        local w = math.max(8, size.X * scale * 0.5)
        local h = math.max(12, size.Y * scale * 0.5)
        e.box.Visible = true; e.box.Size = Vector2.new(w, h)
        e.box.Position = Vector2.new(sp.X - w/2, sp.Y - h/2)
        e.name.Visible = DR.espNames
        e.name.Position = Vector2.new(sp.X, sp.Y - h/2 - 16)
        e.name.Text = inst.Name
        e.dist.Visible = DR.espDistance
        e.dist.Position = Vector2.new(sp.X, sp.Y + h/2 + 2)
        e.dist.Text = string.format("%dm", math.floor(dist))
    end
    local function scan_world()
        local char = LocalPlayer.Character
        for _, inst in ipairs(Workspace:GetDescendants()) do
            if inst:IsA("BasePart") or inst:IsA("Model") or inst:IsA("Folder") then
                if not (char and inst:IsDescendantOf(char)) then
                    local tag = classify(inst)
                    if tag then
                        if tag == "entity" then DR.entitySet[inst] = true
                        elseif tag == "item" then DR.itemSet[inst] = true end
                        if DR.espOn then pcall(draw_esp, inst, tag) end
                    end
                end
            end
        end
    end
    local function nearest_entity()
        local hrp = MOD.getHRP(); if not hrp then return nil, math.huge end
        local best, bestd = nil, math.huge
        for inst, _ in pairs(DR.entitySet) do
            if inst and inst.Parent then
                local p = get_pos(inst)
                if p then
                    local d = (p - hrp.Position).Magnitude
                    if d < bestd then best, bestd = inst, d end
                end
            end
        end
        return best, bestd
    end
    local function try_fire_prompt(prompt)
        if not prompt or not prompt:IsA("ProximityPrompt") then return false end
        local hold = prompt.HoldDuration or 0
        local ok = pcall(function()
            prompt:InputHoldBegin(); task.wait(hold + 0.15); prompt:InputHoldEnd()
        end)
        if ok then DR.interactions = DR.interactions + 1 end
        return ok
    end
    local function auto_interact_tick()
        if not DR.autoInteract then return end
        local hrp = MOD.getHRP(); if not hrp then return end
        local now = tick(); if now - DR.lastInteract < DR.interactInterval then return end
        DR.lastInteract = now
        local best, bestd = nil, DR.interactRange
        for _, inst in ipairs(Workspace:GetDescendants()) do
            if inst:IsA("ProximityPrompt") and inst.Enabled then
                local p = get_pos(inst.Parent)
                if p then
                    local d = (p - hrp.Position).Magnitude
                    if d < bestd then best, bestd = inst, d end
                end
            end
        end
        if best then try_fire_prompt(best) end
    end
    local function scan_rooms()
        local now = tick(); if now - DR.lastScan < 2.0 then return end
        DR.lastScan = now
        local highest = 0
        for _, inst in ipairs(Workspace:GetDescendants()) do
            if inst:IsA("Model") or inst:IsA("BasePart") then
                local num = tonumber(inst.Name:match("(%d+)"))
                if num and num > highest and num < 1000 then highest = num end
            end
        end
        if highest > 0 and not DR.roomsSeen[highest] then
            DR.roomsSeen[highest] = true
            DR.roomCount = DR.roomCount + 1
            DR.currentRoom = tostring(highest)
        end
    end
    local savedLight = nil
