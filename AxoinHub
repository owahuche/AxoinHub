local MOD = {}

MOD.getHRP = function()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
MOD.getHum = function()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end
MOD.getTool = function()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Tool")
end

MOD.registry = { lastTp = 0, cooldown = 0.6, maxImpulse = 900 }

MOD.physicsTP = function(targetCF)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local now = tick()
    local waitTime = MOD.registry.cooldown - (now - MOD.registry.lastTp)
    if waitTime > 0 then task.wait(waitTime) end
    MOD.registry.lastTp = tick()

    local startPos = hrp.Position
    local target   = targetCF.Position
    local delta    = target - startPos
    local dist     = delta.Magnitude
    if dist < 2 then return end

    local dir     = delta.Unit
    local speed   = math.min(dist / 0.35, MOD.registry.maxImpulse)
    local impulse = dir * speed + Vector3.new(0, 20, 0)

    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
    task.wait(0.08)
    pcall(function()
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
    task.wait(0.02)
    pcall(function() hrp.AssemblyLinearVelocity = impulse end)

    local travelTime = math.min(dist / speed, 0.6)
    local t0 = tick()
    while tick() - t0 < travelTime do
        if not hrp.Parent then return end
        RunService.Heartbeat:Wait()
    end
    pcall(function()
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
end

