local REQUIRE_HWID   = true
local PANDA_SERVICE  = "awesomescrpt"
local PANDA_API      = "https://pandadevelopment.net/v2_validation"
local KEY_CACHE      = "axion_key.txt"

--== HWID ==--
local function getHwid()
    if gethwid then
        local ok, h = pcall(gethwid)
        if ok and h and #tostring(h) > 5 then return tostring(h) end
    end
    if syn and syn.get_hwid then
        local ok, h = pcall(syn.get_hwid)
        if ok and h and #tostring(h) > 5 then return tostring(h) end
    end
    local src = tostring(game.PlaceId) .. ":" .. tostring(game.Players.LocalPlayer.UserId)
    local h = 0
    for i = 1, #src do h = (h * 31 + src:byte(i)) % 2147483647 end
    return "hwid_" .. tostring(h)
end

local MY_HWID = getHwid()

--== VALIDATE ==--
local function validateKey(key, hwid)
    local url
    if REQUIRE_HWID then
        url = PANDA_API .. "?key=" .. key
              .. "&service=" .. PANDA_SERVICE
              .. "&hwid=" .. hwid
    else
        url = PANDA_API .. "?key=" .. key
              .. "&service=" .. PANDA_SERVICE
    end
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if not ok or not res then return false end
    local ok2, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(res)
    end)
    if not ok2 or not data then return false end
    return data.V2_Authentication == "success"
        or data.success == true
        or data.valid == true
end

--== CACHE ==--
local function readCache()
    if readfile and isfile and isfile(KEY_CACHE) then
        local ok, data = pcall(readfile, KEY_CACHE)
        if ok and data and #data > 5 then return data end
    end
    return nil
end
local function writeCache(k)
    if writefile then pcall(writefile, KEY_CACHE, k) end
end
local function clearCache()
    if delfile and isfile and isfile(KEY_CACHE) then
        pcall(delfile, KEY_CACHE)
    end
end

